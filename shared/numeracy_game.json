            25,
            40
          ]
        },
        "num": {
          "kind": "int",
          "min": 1,
          "max": 39
        }
      },
      "constraints": [
        {
          "op": "lt",
          "args": [
            "$num",
            "$denom"
          ]
        }
      ],
      "derived": {
        "exact": {
          "op": "div",
          "args": [
            "$num",
            "$denom"
          ]
        },
        "delta": {
          "kind": "choice",
          "values": [
            0.01,
            0.02,
            0.03,
            0.05,
            0.08
          ]
        }
      },
      "prompt": "Which is equivalent to the fraction {{expr:$num}}/{{expr:$denom}} ?",
      "choices": {
        "mode": "two_decimal_one_distractor",
        "exact": "$exact",
        "delta": "$delta",
        "round_places": 3,
        "n_distractors": 1,
        "clamp_01": true
      },
      "answer": {
        "mode": "choice_is_exact"
      },
      "explain": "{{expr:$num}}/{{expr:$denom}} = {{fmt:$exact,3}}"
    },
