{
  "meta": {
    "version": 1,
    "title": "NumeRace Numeracy Game"
  },
  "rules": {
    "segments_per_round": 8,
    "round_seconds": 90,
    "question_seconds": 10,
    "feedback_seconds": 3.5,
    "shuffle_choices": true
  },
  "limits": {
    "math_ops": [
      "add",
      "sub",
      "mul",
      "div",
      "round"
    ],
    "logic_ops": [
      "gt",
      "lt",
      "eq",
      "and",
      "or",
      "not",
      "ne"
    ]
  },
  "selection": {
    "cooldown_default": 1
  },
  "questions": [
    {
      "id": "q_9f3c2a1b",
      "title": "Which sum is larger?",
      "enabled": true,
      "selection": {
        "weight": 5,
        "cooldown": 1,
        "max_per_round": 999
      },
      "vars": {
        "a": {
          "kind": "int",
          "min": -60,
          "max": 60
        },
        "b": {
          "kind": "int",
          "min": -60,
          "max": 60
        },
        "c": {
          "kind": "int",
          "min": -60,
          "max": 60
        },
        "d": {
          "kind": "int",
          "min": -60,
          "max": 60
        }
      },
      "derived": {
        "left_val": {
          "op": "add",
          "args": [
            "$a",
            "$b"
          ]
        },
        "right_val": {
          "op": "sub",
          "args": [
            "$c",
            "$d"
          ]
        }
      },
      "prompt": "Which sum is larger?",
      "choices": {
        "mode": "computed_items",
        "items": [
          {
            "label": "{{expr:$a}} + {{expr:$b}}",
            "value": "$left_val"
          },
          {
            "label": "{{expr:$c}} - {{expr:$d}}",
            "value": "$right_val"
          }
        ]
      },
      "answer": {
        "mode": "argmax",
        "field": "value",
        "tie_break": "random"
      },
      "explain": "{{choice:0.label}} = {{choice:0.value}} ; {{choice:1.label}} = {{choice:1.value}}"
    },
